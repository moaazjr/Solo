generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LeadStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  COMPLETED
}

model Lead {
  id          String     @id @default(cuid())
  fullName    String
  email       String
  company     String?
  service     String
  budget      String?
  message     String
  status      LeadStatus @default(NEW)
  ipHash      String?
  userAgent   String?
  emailSent   Boolean    @default(false)
  emailError  String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([ipHash, createdAt])
  @@index([email, createdAt])
}

model Service {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  tagline     String
  summary     String
  description String
  icon        String   @default("Sparkles")
  features    String[]
  benefits    String[]
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, order])
}

model Project {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  client        String
  category      String
  year          Int
  summary       String
  challenge     String
  solution      String
  results       String[]
  technologies  String[]
  coverImage    String
  featured      Boolean  @default(false)
  isPlaceholder Boolean  @default(true)
  published     Boolean  @default(true)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([published, order])
  @@index([category])
}

model Testimonial {
  id            String   @id @default(cuid())
  quote         String
  author        String
  role          String
  company       String
  isPlaceholder Boolean  @default(true)
  published     Boolean  @default(true)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ipHash    String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
}
