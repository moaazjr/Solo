# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored. Never commit real credentials.
# ─────────────────────────────────────────────────────────────

# Public URL of the site (no trailing slash). Used for SEO, sitemap and emails.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# PostgreSQL connection string.
# Neon (recommended):  postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Local Postgres:      postgresql://postgres:postgres@localhost:5432/solo
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/solo"

# ── SMTP (Nodemailer) ────────────────────────────────────────
# Gmail: host smtp.gmail.com, port 465, secure true, and an App Password
# (Google Account → Security → 2-Step Verification → App passwords).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-account@gmail.com"
SMTP_PASSWORD="your-app-password"

# "From" address shown on notification emails (usually the same as SMTP_USER).
MAIL_FROM="Solo Website <your-account@gmail.com>"

# Where new lead notifications are delivered.
LEAD_NOTIFICATION_EMAIL="mohamedmoaaz375@gmail.com"

# ── Security ─────────────────────────────────────────────────
# Long random string used to sign admin sessions and hash visitor IPs.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-with-a-long-random-string"

# Used once by `npm run admin:create` to create the first admin account.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="choose-a-strong-password-min-12-chars"
ADMIN_NAME="Founder"
